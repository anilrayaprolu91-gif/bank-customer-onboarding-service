                "{{accountId}}"
              ]
            }
          }
        },
        {
          "name": "09 Close Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}

